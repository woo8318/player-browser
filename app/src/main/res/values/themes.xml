<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlayerBrowser" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Dedicated black, edge-to-edge theme for the native Media3 video player. -->
    <style name="Theme.PlayerBrowser.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
